{
  "schema": "qe-evidence-cases.v1",
  "target": "candidate",
  "note": "Oracle for task verify:evidence-candidate. Proves the joined package re-exports the whole public surface as the same objects the leaf modules define, and re-runs every leaf check on the joined commit so a join cannot quietly drift the label or verdict behaviour the leaf tasks already established, in either direction: good input and refused input alike. join_negative_controls and stdlib_negative_controls are calibration, not candidate input: the referee builds each declared broken shape and fails unless its own join and import predicates refuse every one of them, so \"the control passed\" cannot mean \"the candidate never happened to trip it\". The restated_export controls cover both a function export and a tuple export, because copying a function and copying a tuple fail along different paths.",
  "blocking_reason_contract": "blocking_reasons carries exactly one entry per unmet condition, each entry containing that condition's name as a substring, the whole tuple sorted ascending, and empty exactly when promotable is true. expected_reason_tokens lists the condition names for each case.",
  "checks": [
    "package_exports_joined",
    "package_join_control",
    "vocabulary_frozen",
    "promotion_gates_frozen",
    "canonical_labels_positive",
    "canonical_labels_order_and_type",
    "canonical_labels_rejects_invalid",
    "merge_labels_positive",
    "merge_labels_preserves_inputs",
    "derive_promotion_verdicts",
    "derive_promotion_rejects_bad_gates",
    "verdict_value_immutable",
    "verdict_imports_labels",
    "stdlib_only_imports",
    "stdlib_import_control"
  ],
  "vocabulary": [
    "CURRENT_CONSTITUENT_SURVIVORSHIP",
    "FORWARD_OPTION_OBSERVATION",
    "PAPER_OBSERVATION",
    "POINT_IN_TIME_PROVIDER",
